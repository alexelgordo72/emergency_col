# ============================================================
# SGRD - Git Ignore
# ============================================================

# ---------- Flutter/Dart ----------
.dart_tool/
.build/
build/
.pub/
.pub-cache/
.flutter
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
*.pem
*.key
*.crt
*.der
*.p8
*.p12
*.jks

# ---------- Android ----------
android/app/build/
android/.gradle/
android/local.properties
android/*.iml
android/.idea/

# ---------- iOS ----------
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
ios/.idea/

# ---------- Web ----------
web/index.html.bak

# ---------- MacOS ----------
macos/Pods/
macos/.symlinks/

# ---------- Linux/Windows ----------
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.iml

# ---------- System ----------
.DS_Store
Thumbs.db
.CFUserTextEncoding
.profile
.bash_history
.zsh_history
.zsh_sessions/
.zshrc
.zshrc.backup
.zcompdump
.Rhistory
.Rapp.history
.default.profraw
*.profraw

# ---------- Logs ----------
*.log
logs/

# ---------- Environment ----------
.env
*.env
.env.*

# ---------- Firebase ----------
google-services.json
GoogleService-Info.plist
firebase_options.dart

# ---------- Backups ----------
*.tar.gz
*.zip
*.backup
backup/
backup_*/
backup_*.sql
*.sql.gz
sgrd_yumbo_db_*.sql
backup_desarrollo_*.sql

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- Home folders (NO SUBIR A GIT) ----------
Desktop/
Documents/
Downloads/
Library/
Movies/
Music/
Pictures/
Public/
Applications/
Virtual Machines.localized/
VirtualBox VMs/
Parallels/

# ---------- Cloud Storage ----------
Google Drive
OneDrive
Dropbox

# ---------- Herramientas locales ----------
.ssh/
.pgadmin/
.config/
.cache/
.local/
.homebrew/
.gsutil/
.ollama/
.copilot/
.swt/
