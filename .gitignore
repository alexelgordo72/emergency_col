# ---------- Proyectos externos ----------
ia-local/
llama.cpp/

# ---------- Base de datos local ----------
*.sql
*.db
*.sqlite
*.sqlite3

# ---------- ETL SGRD (datos sensibles) ----------
etl/data/input/*
etl/data/output/*
etl/logs/*
!etl/data/input/.gitkeep
!etl/data/output/.gitkeep
!etl/logs/.gitkeep
etl/.env
etl/venv/
etl/__pycache__/
etl/tests/__pycache__/

# ---------- Archivos de configuración local ----------
*.code-workspace
*.sublime-project
*.sublime-workspace
