# ============================================================
# ETL SGRD - Git Ignore
# ============================================================

# Datos de entrada (PDFs - no subir a Git)
data/input/*
!data/input/.gitkeep

# Datos de salida (JSON y SQL generados)
data/output/*
!data/output/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Tests
tests/__pycache__/
tests/.pytest_cache/

# Entorno virtual
venv/
__pycache__/
*.pyc

# Variables de entorno (credenciales)
.env

# Archivos temporales
*.tmp
.DS_Store
