# ============================================================
# Configuración del ETL SGRD
# ============================================================

# Google Gemini API
GEMINI_API_KEY=tu-api-key-aqui

# Base de datos PostgreSQL
DB_HOST=10.147.17.24
DB_PORT=5432
DB_NAME=comunidad_db
DB_USER=admin_comunidad
DB_PASSWORD=tu-password-aqui

# Rutas
CARPETA_RUFE_PDFS=/Users/admin/Desktop/SGRD 2026
CARPETA_OUTPUT=./data/output
CARPETA_LOGS=./logs

# Configuración del ETL
MODELO_GEMINI=gemini-3.1-flash-lite
TIMEOUT_SEGUNDOS=60
MAX_REINTENTOS=3

# Modo de ejecución
DRY_RUN=true
